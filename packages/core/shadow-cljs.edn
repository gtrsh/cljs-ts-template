{:source-paths ["src" "test"]
 :dependencies [[funcool/promesa "11.0.678"]]

 :builds
 {:core
  {:target     :esm
   :output-dir "dist"
   :runtime    :browser
   :modules    {:index {:exports {createApp          app.entry/create-app
                                   createAppWithDeps  app.entry/create-app-with-deps}}}
   :compiler-options {:output-feature-set :es2020
                      :infer-externs :auto}}

  :test
  {:target    :node-test
   :output-to "out/node-tests.js"
   :ns-regexp "-test$"
   :autorun   true}}}
