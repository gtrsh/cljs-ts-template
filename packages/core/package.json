{
  "name": "@myapp/core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "types"],
  "scripts": {
    "watch":      "shadow-cljs watch core",
    "compile":    "shadow-cljs compile core",
