    "repl":       "shadow-cljs cljs-repl core",
    "test":       "shadow-cljs compile test",
    "test:watch": "shadow-cljs watch test",
    "clean":      "rm -rf dist .shadow-cljs .cpcache out"
  },
  "dependencies": {
    "idb-keyval": "^6.2.2"
  },
  "devDependencies": {
    "shadow-cljs": "^3.3.6"
  }
